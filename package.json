{
  "name": "dsh-galgame-generator",
  "version": "0.2.0",
  "description": "Galgame generator for DeepSeek Harness (DSH): give it a script document plus character/background/BGM/animation assets in the workspace (img_human/, img_bg/, audio/, img_cg/) and it builds a playable visual-novel web page with configurable save slots, speaker-following multi-pose sprites, [表情]/[位置]/[退场] stage control, opening/ending/CG animations, BGM control and if-line branching. DSH Galgame 生成器：提供剧本文档 + 立绘/背景/音乐/动画素材（img_human/、img_bg/、audio/、img_cg/）即可生成可玩视觉小说（可配置存档、多表情立绘、站位/退场控制、动画、BGM、if 条件线）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baisama-cloud/dsh-galgame-generator.git"
  },
  "bugs": {
    "url": "https://github.com/baisama-cloud/dsh-galgame-generator/issues"
  },
  "homepage": "https://github.com/baisama-cloud/dsh-galgame-generator#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "pack": "npm pack"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "galgame",
    "visual-novel",
    "web-ui",
    "novel"
  ]
}
